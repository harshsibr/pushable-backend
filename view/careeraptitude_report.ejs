    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

    <script>
        var heartfunction = function (heart, moviesLength, id) {
            var barLine = null;
            var canvas = document.getElementById(id);
            canvas.height = moviesLength * 50;
            var movieName = [];
            var moviePercentage = [];

            for (var i = 0; i < moviesLength; i++) {
                movieName.push(heart[i]["movieName"]);
                moviePercentage.push(heart[i]["moviePercentage"]);
            }

            var data = {
                // labels: movieName,
                labels: movieName.map((name, index) => `${name} (${moviePercentage[index]}%)`),
                datasets: [{
                    label: "Percentage",
                    // backgroundColor: "#849C8A",
                    backgroundColor: "#0e9f6e",
                    fill: true,
                    data: moviePercentage
                }]
            };

            var ctx = document.getElementById(id).getContext("2d");

            const verticalLine = {
                renderVerticalLine: function (chartInstance, pointIndex, i) {
                    const xaxis = chartInstance.scales["x-axis-0"];
                    const yaxis = chartInstance.scales["y-axis-0"];
                    const context = chartInstance.chart.ctx;

                    // render vertical line
                    context.beginPath();
                    context.strokeStyle = "#777777";
                    context.moveTo(xaxis.getPixelForValue(pointIndex), yaxis.top);
                    context.lineTo(xaxis.getPixelForValue(pointIndex), yaxis.bottom);
                    context.stroke();
                },
                afterDatasetsDraw: function (chart, easing) {
                    const xaxis = chart.scales["x-axis-0"];
                    const interval = 10;

                    for (let i = interval; i < xaxis.max; i += interval) {
                        this.renderVerticalLine(chart, i, i / interval - 1);
                    }
                }
            };

            Chart.plugins.register(verticalLine);

            if (barLine != null) {
                barLine.remove();
            }

            barLine = new Chart(ctx, {
                type: "horizontalBar",
                data: data,
                options: {
                    responsive: true,
                    legend: {
                        display: false,
                    },

                    animation: {
                        duration: 0,
                    },
                    scales: {
                        xAxes: [{
                            display: true,
                            ticks: {
                                display: true,
                                fontColor: "black",
                                beginAtZero: true,
                                stepSize: 10,
                                max: 100
                            },
                            gridLines: {
                                display: false
                            }
                        }],
                        yAxes: [{
                            barPercentage: 0.4,
                            ticks: {
                                display: true,
                                fontColor: "black"
                            },
                            gridLines: {
                                display: false
                            }
                        }]
                    },
                    plugins: {
                        datalabels: {
                            anchor: 'end',
                            align: 'end',
                            color: 'black',
                            font: {
                                size: 14,
                            },
                            formatter: function (value, context) {
                                return value + '%';
                            }
                        }
                    }
                },
                label: "Progress"
            });
        };

        // Define different movie data with different percentages
        var heart1 = {
            0: {
                movieName: "YOUR SCORE",
                moviePercentage: <%=answer.percentage.Openness_percentage %>
        },
            1: {
                movieName: "AVERAGE SCORE",
                moviePercentage: 53
            },
        };
        var heart2 = {
            0: {
                movieName: "YOUR SCORE",
                moviePercentage: <%=answer.percentage.Conscientiousness_percentage %>
         },
            1: {
                movieName: "AVERAGE SCORE",
                moviePercentage: 57
            },
        };
        var heart3 = {
            0: {
                movieName: "YOUR SCORE",
                moviePercentage: <%=answer.percentage.Agreableness_percentage %>
         },
            1: {
                movieName: "AVERAGE SCORE",
                moviePercentage: 68
            },
        };
        var heart4 = {
            0: {
                movieName: "YOUR SCORE",
                moviePercentage: <%=answer.percentage.Extraversion_percentage %>
         },
            1: {
                movieName: "AVERAGE SCORE",
                moviePercentage: 55
            },
        };
        var heart5 = {
            0: {
                movieName: "YOUR SCORE",
                moviePercentage: <%=answer.percentage.Neuroticism_percentage %>
         },
            1: {
                movieName: "AVERAGE SCORE",
                moviePercentage: 51
            },
        };

        var heart6 = {
            0: {
                movieName: "Building",
                moviePercentage: <%=answer.holland_percentage.Building_percentage %>
         },
            1: {
                movieName: "Thinking",
                moviePercentage: <%=answer.holland_percentage.Thinking_percentage %>
         },
            2: {
                movieName: "Creating",
                moviePercentage: <%=answer.holland_percentage.Creating_percentage %>
         },
            3: {
                movieName: "Helping",
                moviePercentage: <%=answer.holland_percentage.Helping_percentage %>
         },
            4: {
                movieName: "Persuading",
                moviePercentage: <%=answer.holland_percentage.Persuading_percentage %>
         },
            5: {
                movieName: "Organizing",
                moviePercentage: <%=answer.holland_percentage.Organizing_percentage %>
         },
        };

        var heart7 = {
            0: {
                movieName: "Openness",
                moviePercentage: <%=answer.percentage.Openness_percentage %>
         },
            1: {
                movieName: "Conscientiousness",
                moviePercentage: <%=answer.percentage.Conscientiousness_percentage %>
         },
            2: {
                movieName: "Extraversion",
                moviePercentage: <%=answer.percentage.Extraversion_percentage %>
         },
            3: {
                movieName: "Agreeableness",
                moviePercentage: <%=answer.percentage.Agreableness_percentage %>
         },
            4: {
                movieName: "Neuroticism",
                moviePercentage: <%=answer.percentage.Neuroticism_percentage %>
         },
        };

        // Call the function with different data
        heartfunction(heart1, Object.keys(heart1).length, "hearthorizontalline");
        heartfunction(heart2, Object.keys(heart2).length, "hearthorizontalline1");
        heartfunction(heart3, Object.keys(heart3).length, "hearthorizontalline2");
        heartfunction(heart4, Object.keys(heart4).length, "hearthorizontalline3");
        heartfunction(heart5, Object.keys(heart5).length, "hearthorizontalline4");
        heartfunction(heart6, Object.keys(heart6).length, "hearthorizontalline5");

        heartfunction(heart7, Object.keys(heart7).length, "hearthorizontalline6");

    </script>

