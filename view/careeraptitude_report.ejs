    <script>
        function createPolarChart(Id, pattern, A, B, C, D) {
            var chrt = document.getElementById(Id).getContext("2d");
            function getNumberString(index) {
                const numberStrings = [A, B, C, D];
                return numberStrings[index] || '';
            }
            var chartId = new Chart(chrt, {
                type: 'polarArea',
                data: {

                    datasets: [{
                        data: [pattern[0], pattern[1], pattern[2], pattern[3]],
                        backgroundColor: ['rgb(0 67 255 / 45%)', '#ffa50187', 'rgb(133 119 175)', 'rgb(97 179 97 / 59%)'],
                        borderColor: 'transparent',
                    }],
                },
                options: {
                    responsive: false,
                    animation: {
                        animateRotate: false,
                        animateScale: false
                    },
                    scale: {
                        // gridLines: {
                        //     color: 'transparent'
                        // }
                        display: false
                    }
                },
            });

        }
        var core_pattern = [ <%=answer.core_pattern.DA %>, <%=answer.core_pattern.ERFS %>, <%=answer.core_pattern.EE %>,  <%=answer.core_pattern.EI %> ];
        var interpersonal_pattern = [<%=answer.interpersonal_pattern.IO %>,<%=answer.interpersonal_pattern.EL %>,<%=answer.interpersonal_pattern.AL %>,<%=answer.interpersonal_pattern.SC %> ];
        var communication_pattern = [<%=answer.communication_pattern.TC %>,<%=answer.communication_pattern.CC %>,<%=answer.communication_pattern.EC %>,<%=answer.communication_pattern.EIN %>];
        var motivation_pattern = [<%=answer.motivation_pattern.CE %>,<%=answer.motivation_pattern.ERE %>,<%=answer.motivation_pattern.SPC %>,<%=answer.motivation_pattern.RA %>];
        var productivity_pattern = [<%=answer.productivity_pattern.IA %>,<%=answer.productivity_pattern.IE %>, <%=answer.productivity_pattern.PF %>,<%=answer.productivity_pattern.DOP %>];
        var collaboration_innovation_pattern = [<%=answer.collaboration_innovation_pattern.RI %>,<%=answer.collaboration_innovation_pattern.SI %>,  <%=answer.collaboration_innovation_pattern.CM %>, <%=answer.collaboration_innovation_pattern.HP %>];

        var emotional_pattern = [<%=answer.emotional_pattern.SGI %>,<%=answer.emotional_pattern.CA %>, <%=answer.emotional_pattern.RS %>,<%=answer.emotional_pattern.CO %>];
        var rewards_pattern = [<%=answer.rewards_pattern.GOT %>,<%=answer.rewards_pattern.IA %>, <%=answer.rewards_pattern.RSR %>,<%=answer.rewards_pattern.RSO %>];
        var esteem_pattern = [<%=answer.esteem_pattern.IE %>, <%=answer.esteem_pattern.EI %>, <%=answer.esteem_pattern.RSC %>,<%=answer.esteem_pattern.TE %>];
        var social_pattern = [<%=answer.social_pattern.SUT %>, <%=answer.social_pattern.GO %>, <%=answer.social_pattern.TI %>, <%=answer.social_pattern.SOT %>];

        createPolarChart("chartId", core_pattern, "EI", "DA", "EE", "ERFS");
        createPolarChart("chartId_one", interpersonal_pattern, "SC", "IO", "AL", "EL");
        createPolarChart("chartId_two", communication_pattern, "EIN", "TC", "CC", "EC");
        createPolarChart("chartId_three", motivation_pattern, "RA", "CE", "SPC", "ERE");
        createPolarChart("chartId_four", productivity_pattern, "DOP", "IA", "PF", "IE");
        createPolarChart("chartId_five", collaboration_innovation_pattern, "SI", "CM", "RI", "HP");

        // Repeat in section 19 and 20
        createPolarChart("chartId_social", social_pattern, "GO", "SUT", "SOT", "TI");
        createPolarChart("chartId_core", core_pattern, "EI", "DA", "EE", "ERFS");
        createPolarChart("chartId_interpersonal", interpersonal_pattern, "SC", "IO", "AL", "EL");
        createPolarChart("chartId_communication", communication_pattern, "EIN", "TC", "CC", "EC");
        createPolarChart("chartId_emotional", emotional_pattern, "CO", "RS", "SGI", "CA");
        createPolarChart("chartId_motivation", motivation_pattern, "RA", "CE", "SPC", "ERE");
        createPolarChart("chartId_productivity", productivity_pattern, "DOP", "IA", "PF", "IE");
        createPolarChart("chartId_rewards", rewards_pattern, "RSO", "GOT", "RSR", "IA");
        createPolarChart("chartId_esteem", esteem_pattern, "TE", "IE", "RSC", "EI");
        createPolarChart("chartId_collaboration_innovation", collaboration_innovation_pattern, "SI", "CM", "RI", "HP");
    </script>
