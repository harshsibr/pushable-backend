                                                                            <script
                                                                                src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.1.1/chart.min.js"></script>
                                                                            <script
                                                                                src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.7.3/Chart.min.js"></script>
                                                                            <script
                                                                                src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
                                                                            <script
                                                                                src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

                                                                            <script>
                                                                                // for polar chart
                                                                                var chrt = document.getElementById("chartId").getContext("2d");
                                                                                <% function getNumberString(index) { 
                                                                                    const numberStrings = ["Type 1 :", "Type 2 :", "Type 3 :", "Type 4 :", "Type 5 :", "Type 6 :", "Type 7 :", "Type 8 :", "Type 9 :"]; return numberStrings[index] || ''; 
                                                                                }%>
                                                                                var chartId = new Chart(chrt, {
                                                                                    type: 'polarArea',
                                                                                    data: {
                                                                                        // labels: ["Type 1", "Type 2", "Type 3", "Type 4", "Type 5", "Type 6", "Type 7", "Type 8", "Type 9"],
                                                                                        // labels: [<% Object.keys(answer.score).forEach(function(type) { %>'<%= answer.score[type] %>',<% }); %>],
                                                                                        labels: [ <% Object.keys(answer.graphoScore).forEach(function(type, index) { %> '<%= getNumberString(index) %> <%= answer.graphoScore[type] %> %', <% }); %> ],
                                                                                        datasets: [{
                                                                                            label: "online tutorial subjects",
                                                                                            data: <%= JSON.stringify(answer.arrayscore) %>,
                                                                                            backgroundColor: ['#F8AB62', '#FF736B', '#EF5899', '#AF68AA', '#41A8C2', '#00BFD6', '#41C290', '#95E07C', '#F8DC64'],
                                                                                        }],
                                                                                    },
                                                                                    options: {
                                                                                        responsive: false,
                                                                                        animation: {
                                                                                            animateRotate: false,
                                                                                            animateScale: false
                                                                                        }
                                                                                    },
                                                                                });

                                                                                // for body progress
                                                                                var movies = {
                                                                    <% for (let entry of answer.bodyScore) { %>
                                                                        <%= entry[0] %>: { movieName: '<%= entry[1].movieName %>', moviePercentage: <%= entry[1].moviePercentage %> },
                                                                        <% } %>
                                                                    }
                                                                                var moviesLength = Object.keys(movies).length;

                                                                                var calloneBarChart = function () {
                                                                                    var barLine = null;

                                                                                    $("canvas#bodyHorizontalline").remove();
                                                                                    $("div.body-line").append(
                                                                                        '<canvas id="bodyHorizontalline" width="400"></canvas>'
                                                                                    );

                                                                                    var canvas = document.getElementById("bodyHorizontalline");
                                                                                    canvas.height = moviesLength * 50;

                                                                                    var movieName = [];
                                                                                    var moviePercentage = [];

                                                                                    for (var i = 0; i < moviesLength; i++) {
                                                                                        movieName.push(movies[i]["movieName"]);
                                                                                        moviePercentage.push(movies[i]["moviePercentage"]);
                                                                                    }

                                                                                    var data = {
                                                                                        labels: movieName,
                                                                                        datasets: [
                                                                                            {
                                                                                                label: "Percentage",
                                                                                                backgroundColor: "#849C8A",
                                                                                                fill: true,
                                                                                                data: moviePercentage
                                                                                            }
                                                                                        ]
                                                                                    };

                                                                                    var ctx = document.getElementById("bodyHorizontalline").getContext("2d");

                                                                                    const verticalLine = {
                                                                                        renderVerticalLine: function (chartInstance, pointIndex, i) {
                                                                                            const xaxis = chartInstance.scales["x-axis-0"];
                                                                                            const yaxis = chartInstance.scales["y-axis-0"];
                                                                                            const context = chartInstance.chart.ctx;

                                                                                            // render vertical line
                                                                                            context.beginPath();

                                                                                            context.strokeStyle = "#777777";

                                                                                            context.moveTo(xaxis.getPixelForValue(pointIndex), yaxis.top);
                                                                                            context.lineTo(xaxis.getPixelForValue(pointIndex), yaxis.bottom);
                                                                                            context.stroke();
                                                                                        },

                                                                                        afterDatasetsDraw: function (chart, easing) {
                                                                                            const xaxis = chart.scales["x-axis-0"];
                                                                                            const interval = 10;

                                                                                            for (let i = interval; i < xaxis.max; i += interval) {
                                                                                                this.renderVerticalLine(chart, i, i / interval - 1);
                                                                                            }
                                                                                        }
                                                                                    };

                                                                                    Chart.plugins.register(verticalLine);

                                                                                    if (barLine != null) {
                                                                                        barLine.remove();
                                                                                    }

                                                                                    barLine = new Chart(ctx, {
                                                                                        type: "horizontalBar",
                                                                                        data: data,
                                                                                        options: {
                                                                                            responsive: true,
                                                                                            legend: {
                                                                                                display: false,
                                                                                            },
                                                                                            animation: {
                                                                                                duration: 0, // Set animation duration to 0 to disable animations
                                                                                            },
                                                                                            scales: {
                                                                                                xAxes: [
                                                                                                    {
                                                                                                        display: true,
                                                                                                        ticks: {
                                                                                                            display: true,
                                                                                                            fontColor: "black",
                                                                                                            beginAtZero: true,
                                                                                                            stepSize: 10,
                                                                                                            max: 100
                                                                                                        },
                                                                                                        gridLines: {
                                                                                                            display: false
                                                                                                        }
                                                                                                    }
                                                                                                ],
                                                                                                yAxes: [
                                                                                                    {
                                                                                                        barPercentage: 0.4,
                                                                                                        ticks: {
                                                                                                            display: true,
                                                                                                            fontColor: "black"
                                                                                                        },
                                                                                                        gridLines: {
                                                                                                            display: false
                                                                                                        }
                                                                                                    }
                                                                                                ]
                                                                                            },
                                                                                            plugins: {
                                                                                                datalabels: {
                                                                                                    anchor: 'end',
                                                                                                    align: 'end',
                                                                                                    color: 'black',
                                                                                                    font: {
                                                                                                        size: 14,
                                                                                                    },
                                                                                                    formatter: function (value, context) {
                                                                                                        return value + '%';
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        },
                                                                                        label: "Progress"
                                                                                    });
                                                                                };
                                                                                calloneBarChart();

                                                                                // for head progress
                                                                                var head = {
                                                                    <% for (let entry of answer.headScore) { %>
                                                                        <%= entry[0] %>: { movieName: '<%= entry[1].movieName %>', moviePercentage: <%= entry[1].moviePercentage %> },
                                                                        <% } %>
                                                                    }
                                                                                var moviesLength = Object.keys(head).length;

                                                                                var headfunction = function () {
                                                                                    var barLine = null;

                                                                                    $("canvas#headhorizontalline").remove();
                                                                                    $("div.head-line").append(
                                                                                        '<canvas id="headhorizontalline" width="400"></canvas>'
                                                                                    );

                                                                                    var canvas = document.getElementById("headhorizontalline");
                                                                                    canvas.height = moviesLength * 50;

                                                                                    var movieName = [];
                                                                                    var moviePercentage = [];

                                                                                    for (var i = 0; i < moviesLength; i++) {
                                                                                        movieName.push(head[i]["movieName"]);
                                                                                        moviePercentage.push(head[i]["moviePercentage"]);
                                                                                    }

                                                                                    var data = {
                                                                                        labels: movieName,
                                                                                        datasets: [
                                                                                            {
                                                                                                label: "Percentage",
                                                                                                backgroundColor: "#849C8A",
                                                                                                fill: true,
                                                                                                data: moviePercentage
                                                                                            }
                                                                                        ]
                                                                                    };

                                                                                    var ctx = document.getElementById("headhorizontalline").getContext("2d");

                                                                                    const verticalLine = {
                                                                                        renderVerticalLine: function (chartInstance, pointIndex, i) {
                                                                                            const xaxis = chartInstance.scales["x-axis-0"];
                                                                                            const yaxis = chartInstance.scales["y-axis-0"];
                                                                                            const context = chartInstance.chart.ctx;

                                                                                            // render vertical line
                                                                                            context.beginPath();

                                                                                            context.strokeStyle = "#777777";

                                                                                            context.moveTo(xaxis.getPixelForValue(pointIndex), yaxis.top);
                                                                                            context.lineTo(xaxis.getPixelForValue(pointIndex), yaxis.bottom);
                                                                                            context.stroke();
                                                                                        },

                                                                                        afterDatasetsDraw: function (chart, easing) {
                                                                                            const xaxis = chart.scales["x-axis-0"];
                                                                                            const interval = 10;

                                                                                            for (let i = interval; i < xaxis.max; i += interval) {
                                                                                                this.renderVerticalLine(chart, i, i / interval - 1);
                                                                                            }
                                                                                        }
                                                                                    };

                                                                                    Chart.plugins.register(verticalLine);

                                                                                    if (barLine != null) {
                                                                                        barLine.remove();
                                                                                    }

                                                                                    barLine = new Chart(ctx, {
                                                                                        type: "horizontalBar",
                                                                                        data: data,
                                                                                        options: {
                                                                                            responsive: true,
                                                                                            legend: {
                                                                                                display: false,
                                                                                            },
                                                                                            animation: {
                                                                                                duration: 0, // Set animation duration to 0 to disable animations
                                                                                            },
                                                                                            scales: {
                                                                                                xAxes: [
                                                                                                    {
                                                                                                        display: true,
                                                                                                        ticks: {
                                                                                                            display: true,
                                                                                                            fontColor: "black",
                                                                                                            beginAtZero: true,
                                                                                                            stepSize: 10,
                                                                                                            max: 100
                                                                                                        },
                                                                                                        gridLines: {
                                                                                                            display: false
                                                                                                        }
                                                                                                    }
                                                                                                ],
                                                                                                yAxes: [
                                                                                                    {
                                                                                                        barPercentage: 0.4,
                                                                                                        ticks: {
                                                                                                            display: true,
                                                                                                            fontColor: "black"
                                                                                                        },
                                                                                                        gridLines: {
                                                                                                            display: false
                                                                                                        }
                                                                                                    }
                                                                                                ]
                                                                                            },
                                                                                            plugins: {
                                                                                                datalabels: {
                                                                                                    anchor: 'end',
                                                                                                    align: 'end',
                                                                                                    color: 'black',
                                                                                                    font: {
                                                                                                        size: 14,
                                                                                                    },
                                                                                                    formatter: function (value, context) {
                                                                                                        return value + '%';
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        },
                                                                                        label: "Progress"
                                                                                    });
                                                                                };
                                                                                headfunction();

