                                                                                                        }
                                                                                                    }
                                                                                                ],
                                                                                                yAxes: [
                                                                                                    {
                                                                                                        barPercentage: 0.4,
                                                                                                        ticks: {
                                                                                                            display: true,
                                                                                                            fontColor: "black"
                                                                                                        },
                                                                                                        gridLines: {
                                                                                                            display: false
                                                                                                        }
                                                                                                    }
                                                                                                ]
                                                                                            },
                                                                                            plugins: {
                                                                                                datalabels: {
                                                                                                    anchor: 'end',
                                                                                                    align: 'end',
                                                                                                    color: 'black',
                                                                                                    font: {
                                                                                                        size: 14,
                                                                                                    },
                                                                                                    formatter: function (value, context) {
                                                                                                        return value + '%';
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        },
                                                                                        label: "Progress"
                                                                                    });
                                                                                };

                                                                                heartfunction();
                                                                            </script>
