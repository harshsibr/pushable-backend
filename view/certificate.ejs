<html>

<head>
    <title>CERTIFICATE</title>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <style>
        .section {
            background-image: url('https://api.testuity.com/certificate_logo/Certificate.jpg');
            background-size: cover;
            width: 781px;
            height: 603px;
        }

        .section-error {
            background-color: #f0f0f0;
            display: none;
        }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const img = new Image();
            img.src = 'https://api.testuity.com/certificate_logo/Certificate.jpg';
            img.onerror = function() {
                document.querySelector('.section').style.display = 'none';
                document.querySelector('.section-error').style.display = 'block';
            };
        });
    </script>
</head>

<body>
    <div style="display: flex; justify-content: center;">
        <div class="section">
            <div style="display: flex; justify-content: center; align-items: center; flex-direction: column; height: 100%; color: #1b8229;">
                <h5 style="margin: 20px 0; font-size: 24px; margin-top: 87px; font-weight: 500;">
                    <%= answer['name'] %> <%= answer['surname'] %>
                </h5>
                <p style="margin: 0; font-size: 18px;">In recognition for the successful completion of the</p>
                <p style="margin: 0; font-size: 18px;">TAI Certificate IQ test with the following score:</p>
                <h2 style="font-size: 46px; color: #1b8229; text-align: -webkit-center; margin-top: 50px;">
                    <b><%= answer['score'] %></b>
                </h2>
            </div>
        </div>
        <div class="section-error">
            <div style="display: flex; justify-content: center; align-items: center; flex-direction: column; height: 100%; color: #1b8229;">
                <h5 style="margin: 20px 0; font-size: 24px; margin-top: 87px; font-weight: 500;">
                    <%= answer['name'] %> <%= answer['surname'] %>
                </h5>
                <p style="margin: 0; font-size: 18px;">In recognition for the successful completion of the</p>
                <p style="margin: 0; font-size: 18px;">TAI Certificate IQ test with the following score:</p>
                <h2 style="font-size: 46px; color: #1b8229; text-align: -webkit-center; margin-top: 50px;">
                    <b><%= answer['score'] %></b>
                </h2>
            </div>
        </div>
    </div>
</body>

</html>
