                    <th><span>TOTAL</span></th>
                    <td><span data-prefix>$</span><span>
                            <%= newInfo['total_amount'] %>
                        </span></td>
                </tr>
            </table> -->
        </article>
        <h2 style="font-weight: 700; font-size: 20px;"><%= adminInfo?.invoice_object?.InvoiceDetails %></h2>

        <table>
            <tr>
                <th class="lastTable"><%= adminInfo?.invoice_object?.Description %></th>
                <th class="lastTable"><%= adminInfo?.invoice_object?.Qty %></th>
                <th class="lastTable"><%= adminInfo?.invoice_object?.UnitPriceExclVat %></th>
                <th class="lastTable"><%= adminInfo?.invoice_object?.VatRate %></th>
                <th class="lastTable"><%= adminInfo?.invoice_object?.UnitPriceInclVat %></th>
                <th class="lastTable"><%= adminInfo?.invoice_object?.ItemSubtotalInclVat %></th>
            </tr>
            <tr>
                <td class="lastTable">
                    <%= newInfo['description'] %>
                </td>
                <td class="lastTable">
                    <%= newInfo['qty'] %>
                </td>
                <td class="lastTable">
                    <%= newInfo['unit_price'] %>
                </td>
                <td class="lastTable">
                    <%= newInfo['vat_rate'] %>
                </td>
                <td class="lastTable">
                    <span data-prefix>$</span><%= newInfo['unit_price_inc'] %>
                </td>
                <td class="lastTable">
                    <span data-prefix>$</span><%= newInfo['total_amount'] %>
                </td>
            </tr>
        </table>

        <div style="display: flex; flex-direction: column;  align-items: end;">
            <table class="firstTable" style="margin: 0px;">
                <tr>
                    <th style="background-color: white; border-right: none; font-weight: 600;"><span><%= adminInfo?.invoice_object?.InvoiceTotal %></span></th>
                    <td style="text-align: end; border-left: none; font-weight: 600;"><span
                            data-prefix>$</span><span><%= newInfo['total_amount'] %></span></td>
                </tr>
            </table>
            <table class="firstTable">
                <tr>
                    <td style="border: none;"><span><%= adminInfo?.invoice_object?.VatRateTwo %></span></td>
                    <td style="border: none;"><%= adminInfo?.invoice_object?.ItemSubtotalExclVat %></td>
                    <td style="border: none;"><span><%= adminInfo?.invoice_object?.VatSubtotal %></span></td>
                </tr>
                <tr>
                    <th style="border: none;"><span data-prefix>
                            <%= newInfo['vat_rate'] %>
                    </th>
                    <th style="border: none;"><span data-prefix>
                            <%= newInfo['unit_price'] %>
                    </th>
                    <th style="border: none;"><span data-prefix>
                            <%= newInfo['vat_subtotal'] %>
                    </th>
                </tr>
                <tr>
                    <td style="border: none;"><span><%= adminInfo?.invoice_object?.Total %></span></td>
                    <td style="border: none;">
                        <%= newInfo['unit_price'] %>
                    </td>
                    <td style="border: none;"><span>
                            <%= newInfo['vat_subtotal'] %>
                        </span></td>
                </tr>

            </table>
