        <section>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.1.1/chart.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
            <script>
                $(document).ready(function () {
                    function setWidthByClass(className, width, backgroundcolor) {
                        if (width < 30) {
                            var element = document.querySelector(className);
                            if (element) {
                                element.style.width = 35 + '%';
                                element.style.backgroundColor = backgroundcolor;
                            }
                        }
                        else {
                            var element = document.querySelector(className);
                            if (element) {
                                element.style.width = width + '%';
                                element.style.backgroundColor = backgroundcolor;
                            }

                        }

                    }
                    setWidthByClass(".left-one", <%=answer.Reserved_percentage %>, "rgb(0 67 255 / 45%)");
                    setWidthByClass(".right-one", <%=answer.Outgoing_percentage %>, "#ffa50187");
                    setWidthByClass(".left-two", <%=answer.TaskOriented_percentage %>, "rgb(31 31 40 / 37%)");
                    setWidthByClass(".right-two", <%=answer.PeopleOriented_percentage %>, "rgb(246 142 208 / 71%)");
                });
            </script>
        </section>


        <!-- Polar -->
        <section>


            <script>
                var chrt = document.getElementById("chartId").getContext("2d");
    <% function getNumberString(index) {
                    const numberStrings = ["InfluenceDominance:", "Influence :", "InfluenceSteadiness :", "SteadinessInfluence :", "Steadiness :", "SteadinessConscientiousness :", "ConscientiousnessSteadiness :", "Conscientiousness :", "ConscientiousnessDominance :", "DominanceConscientiousness :", "Dominance :", "DominanceInfluence :"];
                    return numberStrings[index] || '';
                } %>
    var answer = {
                    arrayscore: [
            <%= answer.percentage.InfluenceDominance %>,
            <%= answer.percentage.Influence %>,
            <%= answer.percentage.InfluenceSteadiness %>,
            <%= answer.percentage.SteadinessInfluence %>,
            <%= answer.percentage.Steadiness %>,
            <%= answer.percentage.SteadinessConscientiousness %>,
            <%= answer.percentage.ConscientiousnessSteadiness %>,
            <%= answer.percentage.Conscientiousness %>,
            <%= answer.percentage.ConscientiousnessDominance %>,
            <%= answer.percentage.DominanceConscientiousness %>,
            <%= answer.percentage.Dominance %>,
            <%= answer.percentage.DominanceInfluence %>
        ]
                };

                var chartId = new Chart(chrt, {
                    type: 'polarArea',
                    data: {
                        labels: [ <% Object.keys(answer.percentage).forEach(function (type, index) { %> '<%= getNumberString(index) %> <%= answer.percentage[type] %> %', <% }); %> ],
                    datasets: [{
                        data: answer.arrayscore,
                        backgroundColor: ['#e0a07c', '#e0a07c', '#e0a07c', '#7f93da', '#7f93da', '#7f93da', '#afc386', '#afc386', '#afc386', '#e1d27f', '#e1d27f', '#e1d27f'],
                    }]
                },
                    options: {
                    responsive: false,
                    animation: {
                        animateRotate: false,
                        animateScale: false
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                    },
                    scales: {
                        r: {
                            ticks: {
                                display: false // Hide the y-axis labels
                            }
                        }
                    }
                }
    });

                function positionLabels() {
                    const svgNS = "http://www.w3.org/2000/svg";
                    const labels = ['I/d', 'I', 'I/s', 'S/i', 'S', 'S/c', 'C/s', 'C', 'C/d', 'D/c', 'D', 'D/i'];
                    const colors = ['#e0a07c', '#e0a07c', '#e0a07c', '#7f93da', '#7f93da', '#7f93da', '#afc386', '#afc386', '#afc386', '#e1d27f', '#e1d27f', '#e1d27f'];
                    const centerX = 290;
                    const centerY = 200;
                    const radius = 180;

                    labels.forEach((label, index) => {
                        const angle = (Math.PI * 2 * index + 4) / labels.length - Math.PI / 2;
                        const x = centerX + radius * Math.cos(angle);
                        const y = centerY + radius * Math.sin(angle);

                        const text = document.createElementNS(svgNS, "text");
                        text.setAttribute("x", x);
                        text.setAttribute("y", y);
                        text.setAttribute("fill", colors[index]);
                        text.setAttribute("text-anchor", "middle");
                        text.setAttribute("alignment-baseline", "middle");
                        text.setAttribute("class", "custom-label");
                        text.textContent = label;

                        document.getElementById("labels").appendChild(text);
                    });
                }

                positionLabels();
            </script>
        </section>
